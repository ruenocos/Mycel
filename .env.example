# Copy to .env (never commit .env)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Ceiling for all DataforSEO runs in one calendar month, in dollars (default 50, ADR 0004)
DATAFORSEO_MONTHLY_BUDGET_USD=
OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com
# Only for a metered LLM: input/output dollars per million tokens (e.g. 0.3/1.2). Ollama Cloud is a
# subscription: leave it empty. Sets the price behind the LLM --budget and --dry-run of mycel brief
LLM_PRICE_USD_PER_MTOK=
# Path to the GSC service account JSON (outside the repo), forward slashes work on Windows
GSC_CREDENTIALS_PATH=
# sc-domain:example.com for a domain property, https://example.com/ for a URL-prefix one
GSC_PROPERTY=
